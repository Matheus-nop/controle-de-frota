# copie para .env.local e preencha. .env.local NUNCA vai para o repositorio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave `service_role` do Supabase (Project Settings -> API -> service_role).
# Ela ignora a RLS. Duas usos, os dois fora do navegador:
#   * o script de migracao, rodando local;
#   * /api/usuarios, que cria login e troca senha (Route Handler, servidor).
# Nunca use o prefixo NEXT_PUBLIC_ e nunca importe fora de app/api/ ou scripts/.
# Sem ela o app funciona inteiro — so a tela /usuarios avisa que falta
# configurar. No Vercel: Settings -> Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=

# Endereco dos outros sistemas do grupo, para a caixinha "Sistemas" no topo.
# Vazio esconde o item, em vez de levar a um endereco que nao abre. Sem
# nenhuma das duas, a caixinha inteira some.
#
# Precisa ser o endereco COMPLETO, com https:// e sem sinal de "preencha aqui".
# Um valor invalido (o texto de exemplo, por engano) faz o item sumir do menu —
# de proposito: e assim que se descobre que a variavel esta errada.
NEXT_PUBLIC_URL_ROTEIROS=https://roteiros.exemplo.com.br
NEXT_PUBLIC_URL_ESTOQUE=https://estoque.exemplo.com.br
