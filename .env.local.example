# copie para .env.local e preencha. .env.local NUNCA vai para o repositorio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave `service_role` do Supabase (Project Settings -> API -> service_role).
# Ela ignora a RLS. Duas usos, os dois fora do navegador:
#   * o script de migracao, rodando local;
#   * /api/usuarios, que cria login e troca senha (Route Handler, servidor).
# Nunca use o prefixo NEXT_PUBLIC_ e nunca importe fora de app/api/ ou scripts/.
# Sem ela o app funciona inteiro — so a tela /usuarios avisa que falta
# configurar. No Vercel: Settings -> Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=
